# Canvas LMS
CANVAS_BASE_URL=https://tu-institucion.instructure.com
CANVAS_API_TOKEN=your_canvas_api_token

# Microsoft Graph / Azure AD
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# Teams
TEAMS_DEFAULT_TEAM_ID=your_default_team_id

# Email (opcional)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@tu-institucion.edu
SMTP_PASSWORD=your_smtp_password

# App
APP_SECRET_KEY=change_this_in_production
DEBUG=false

# Auth JWT
JWT_EXPIRE_MINUTES=480

# Login local (generar hash con: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('tu_password'))")
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$...hash_aqui...

# Azure AD OAuth2 redirect (ajustar al dominio real en producción)
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/azure/callback
