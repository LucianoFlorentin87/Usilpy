# ── Canvas LMS ────────────────────────────────────────────────────────────────
CANVAS_BASE_URL=https://tu-institucion.instructure.com
CANVAS_API_TOKEN=your_canvas_api_token

# ── Microsoft Graph / Azure AD ────────────────────────────────────────────────
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# ── Microsoft Teams ───────────────────────────────────────────────────────────
TEAMS_DEFAULT_TEAM_ID=your_default_team_id
TEAMS_BASE_URL=https://teams.microsoft.com
# Incoming Webhook URL del canal institucional (para notificaciones de matriculación)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ── OneDrive — Excel de Matriculación ─────────────────────────────────────────
# ID del archivo Excel en OneDrive (obtenido desde la URL de SharePoint/OneDrive)
ONEDRIVE_FILE_ID=your_excel_file_id
# ID del drive (necesario para autenticación app-only); vacío = drive personal del SP
ONEDRIVE_DRIVE_ID=your_drive_id

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@usil.edu.py
SMTP_PASSWORD=your_smtp_password
# Email del administrador para recibir reportes de error
ADMIN_EMAIL=admin@usil.edu.py

# ── Matriculación Automática ──────────────────────────────────────────────────
# Semestre actual (se usa como etiqueta en cursos y reportes)
SEMESTRE_ACTUAL=2025-2
# Hora de ejecución del cron diario (formato HH:MM, zona UTC)
CRON_HORA=07:00

# ── App ────────────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change_this_in_production
DEBUG=false

# ── Auth JWT ───────────────────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=480

# Login local (generar hash con: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('tu_password'))")
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$...hash_aqui...

# Azure AD OAuth2 redirect (ajustar al dominio real en producción)
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/azure/callback
